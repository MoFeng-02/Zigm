<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>false</InvariantGlobalization>
		<Version>1.0.1</Version>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<FileVersion>$(Version)</FileVersion>
	</PropertyGroup>

	<Target Name="GenerateVersionFile" BeforeTargets="BeforeCompile">
		<PropertyGroup>
			<_VersionFileContent>{ "version": "$(Version)" }</_VersionFileContent>
		</PropertyGroup>
		<ItemGroup>
			<EmbeddedResource Include="version.json">
				<LogicalName>Zigm.version.json</LogicalName>
			</EmbeddedResource>
		</ItemGroup>
		<WriteLinesToFile File="$(IntermediateOutputPath)version.json" Lines="$(_VersionFileContent)" Overwrite="true" />
		<Copy SourceFiles="$(IntermediateOutputPath)version.json" DestinationFiles="$(MSBuildProjectDirectory)\version.json" SkipUnchangedFiles="true" />
	</Target>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
	  <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Languages\AppLang.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>AppLang.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Languages\AppLang.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>AppLang.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

</Project>
